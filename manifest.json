{
  "id": "/audipo2/",
  "name": "Audipo風 練習プレイヤー＆レコーダー",
  "short_name": "Audipo2",
  "description": "高音質スロー再生・区間リピート・24bit録音・メトロノーム・YouTube練習プレイヤー",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111113",
  "theme_color": "#111113",
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html?launch_files=1",
      "accept": {
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/mp4": [
          ".m4a"
        ],
        "audio/x-m4a": [
          ".m4a"
        ],
        "audio/wav": [
          ".wav"
        ],
        "audio/x-wav": [
          ".wav"
        ],
        "audio/aac": [
          ".aac"
        ],
        "audio/ogg": [
          ".ogg",
          ".opus"
        ],
        "audio/opus": [
          ".opus"
        ],
        "audio/flac": [
          ".flac"
        ],
        "audio/webm": [
          ".webm"
        ],
        "audio/3gpp": [
          ".3gp"
        ],
        "audio/aiff": [
          ".aif",
          ".aiff"
        ],
        "audio/x-aiff": [
          ".aif",
          ".aiff"
        ],
        "audio/x-ms-wma": [
          ".wma"
        ],
        "audio/x-caf": [
          ".caf"
        ]
      }
    },
    {
      "action": "./index.html?launch_files=1",
      "accept": {
        "text/plain": [
          ".txt"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "audio/*",
            "text/plain",
            "application/json",
            ".mp3",
            ".m4a",
            ".wav",
            ".aac",
            ".flac",
            ".ogg",
            ".opus",
            ".wma",
            ".aif",
            ".aiff",
            ".caf",
            ".3gp",
            ".txt",
            ".json"
          ]
        }
      ]
    }
  }
}
